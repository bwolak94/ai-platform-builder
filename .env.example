# OpenAI — required for agent LLM calls and embeddings
OPENAI_API_KEY=sk-...

# Upstash Vector — required for RAG retrieval
UPSTASH_URL=https://...upstash.io
UPSTASH_TOKEN=...

# Braintrust — required for eval tracking and trace logging
BRAINTRUST_API_KEY=...

# Frontend — URL of the Cloudflare Worker (WebSocket)
VITE_AGENT_URL=ws://localhost:8787

# App environment
VITE_APP_ENV=development

# Eval runner — URL of the deployed or local worker
AGENT_URL=ws://localhost:8787
